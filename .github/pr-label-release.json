{
  "schema_version": 1,
  "policy": {
    "source_of_truth": "pull-request-labels",
    "trusted_gate_workflow": "Label Gate",
    "release_workflow": "Release",
    "failure_notification_workflow": "Notify release failure",
    "unknown_release_labels": "fail",
    "duplicate_release_labels": "fail",
    "missing_required_release_labels": "fail",
    "persist_release_intent": {
      "mode": "per-pr-identity",
      "snapshot_artifact": "release-intent.json",
      "backfill_entrypoint": "workflow_dispatch",
      "queue_strategy": "none"
    },
    "same_repository_cask": {
      "path": "Casks/spotibind.rb",
      "branch_prefix": "automation/cask-release-",
      "release_mode": "type:none",
      "auto_merge": true,
      "public_release_gate": "Finalize Cask release"
    }
  },
  "label_groups": [
    {
      "name": "type",
      "prefix": "type:",
      "required": true,
      "cardinality": "exactly-one",
      "allowed": ["type:major", "type:minor", "type:patch", "type:none"]
    },
    {
      "name": "channel",
      "prefix": "channel:",
      "required": true,
      "cardinality": "exactly-one",
      "allowed": ["channel:stable"]
    }
  ],
  "defaults": ["type:patch", "channel:stable"],
  "release_snapshot": {
    "fields": [
      "pull_request",
      "merge_commit_sha",
      "head_sha",
      "labels",
      "type",
      "channel",
      "version",
      "artifact_names",
      "cask_version",
      "cask_sha256",
      "cask_url",
      "run_url"
    ]
  },
  "required_quality_gate": {
    "check_name": "Label Gate",
    "quality_gates_declaration": ".github/quality-gates.json"
  }
}
